@Library('sharedlib-rahul') _

pipeline{
    agent any
    
    tools {
        maven 'Maven-3.8'
    }
    
    stages{
        stage('parallel Task-1'){
            parallel{
                stage('Github checkout and test(jacoco)'){
                    steps{
                        sendslacknotifications('STARTED')
                     git branch: 'jio-qa', url: 'https://github.com/Kuchi-Rahul/maven-webapplication-project-kkfunda.git'
                    }
                }
                
                stage('Maven'){
                    steps{
                        sh "mvn test"
                        jacoco buildOverBuild: true, changeBuildStatus: true, runAlways: true, skipCopyOfSrcFiles: true
                    }
                }
                
            }
        }
        
        stage('Parallel Task-2'){
            parallel{
                stage('sonarQube'){
                    steps{
                        sh "mvn sonar:sonar"
                    }
                }
                
                stage('Nexus'){
                    steps{
                        sh "mvn deploy"
                    }
                }
            }
        }
        
        stage('parallel Task-3'){
            parallel{
                stage('Tomcat'){
                    steps{
                         deploy adapters: [tomcat9(alternativeDeploymentContext: '', credentialsId: 'e633e927-d761-4c1f-aef1-baf4b4bc22a2', path: '', url: 'http://localhost:8082/')], contextPath: null, war: '**/maven-web-application.war'
                    }
                }
            }
        }
        
      }
    
    
    post{
        success{
            script{
                sendslacknotifications(currentBuild.result)
            }
        }
        
        failure{
            script{
                sendslacknotifications(currentBuild.result)
            }
        }
    }
    
}
